{
  "name": "folio",
  "private": true,
  "version": "1.0.0",
  "description": "Folio — a lightweight collaborative document editor (Ajaia take-home)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.3.2",
    "turndown": "^7.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
